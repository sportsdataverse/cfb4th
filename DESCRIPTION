Type: Package
Package: cfb4th
Title: Optimal Fourth Down Decisions in College Football
Version: 0.2.0
Authors@R: c(
    person("Jared", "Lee", , "13jaredlee@gmail.com", role = c("aut", "cph")),
    person("Ben", "Baldwin", , "bbaldwin206@gmail.com", role = "aut"),
    person("Sebastian", "Carl", , "mrcaseb@gmail.com", role = "ctb"),
